# Public site URL, used for sitemap, canonical links and social cards
NEXT_PUBLIC_SITE_URL=https://datalearn.org

# Optional: email a copy of every form submission via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# FAQ chatbot (OpenAI). Without a key the chat button still shows, but tells visitors to use the contact form.
OPENAI_API_KEY=
# Optional: any chat model your OpenAI account can use
OPENAI_MODEL=gpt-5-mini
